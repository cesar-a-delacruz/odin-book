// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid(7))
  username  String     @unique @db.VarChar(20)
  fullname  String     @db.VarChar(40)
  password  String     @db.Char(60)
  bio       String?    @db.VarChar(100)
  image     String?    @db.Text
  posts     Post[]
  comments  Comment[]
  likes     Like[]
  followers Follower[] @relation(name: "follower_follower_id_fkey")
  followed  Follower[] @relation(name: "follower_followed_id_fkey")

  @@index([id])
  @@map("user")
}

model Post {
  id        String    @id @default(uuid(7))
  content   String    @db.Text
  image     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments  Comment[]
  likes     Like[]

  @@index([userId])
  @@map("post")
}

model Comment {
  id        String   @id @default(uuid(7))
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@map("comment")
}

model Like {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("like")
}

model Follower {
  followerId String @map("follower_id")
  follower   User   @relation(fields: [followerId], references: [id], onDelete: Cascade, name: "follower_follower_id_fkey")
  followedId String @map("followed_id")
  followed   User   @relation(fields: [followedId], references: [id], onDelete: Cascade, name: "follower_followed_id_fkey")

  @@id([followerId, followedId])
  @@map("follower")
}
